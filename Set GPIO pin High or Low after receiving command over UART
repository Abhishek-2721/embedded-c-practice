#include <stdio.h>
#include <string.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/uart.h"
#include "driver/gpio.h"

#define UART_PORT UART_NUM_0
#define BUF_SIZE 128

#define LED_GPIO 26

void app_main(void)
{
    uint8_t rx_byte;
    char command[BUF_SIZE];
    int index = 0;

    // -------------------------------
    // GPIO configuration
    // -------------------------------

    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << LED_GPIO),
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE
    };

    gpio_config(&io_conf);

    // Initially keep GPIO LOW
    gpio_set_level(LED_GPIO, 0);

    // -------------------------------
    // UART configuration
    // -------------------------------

    uart_config_t uart_config = {
        .baud_rate = 115200,
        .data_bits = UART_DATA_8_BITS,
        .parity = UART_PARITY_DISABLE,
        .stop_bits = UART_STOP_BITS_1,
        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE
    };

    uart_param_config(UART_PORT, &uart_config);

    uart_driver_install(
        UART_PORT,
        BUF_SIZE * 2,
        0,
        0,
        NULL,
        0
    );

    printf("UART command receiver started\r\n");

    // -------------------------------
    // Main loop
    // -------------------------------

    while (1)
    {
        int len = uart_read_bytes(UART_PORT,&rx_byte,1,pdMS_TO_TICKS(100));

        if (len > 0)
        {
            // Check for Enter
            if (rx_byte == '\r' || rx_byte == '\n')
            {
                if (index > 0)
                {
                    command[index] = '\0';

                    printf("Received: %s\r\n", command);

                    // -------------------------------
                    // Check command
                    // -------------------------------

                    if (strcmp(command, "HI") == 0)
                    {
                        // Set GPIO 26 HIGH
                        gpio_set_level(LED_GPIO, 1);

                        printf("GPIO 26 HIGH\r\n");

                        uart_write_bytes(UART_PORT,"OK\r\n",4);
                    }
                    if (strcmp(command, "BYE") == 0)
                    {
                        // Set GPIO 26 LOW
                        gpio_set_level(LED_GPIO, 0);

                        printf("GPIO 26 LOW\r\n");

                        uart_write_bytes(UART_PORT,"OK\r\n",4);
                    }
                    else
                    {
                        uart_write_bytes(
                            UART_PORT,
                            "UNKNOWN COMMAND\r\n",
                            strlen("UNKNOWN COMMAND\r\n")
                        );
                    }

                    // Reset command buffer
                    index = 0;
                }
            }
            else
            {
                // Store received character
                if (index < BUF_SIZE - 1)
                {
                    command[index] = rx_byte;
                    index++;
                }
            }
        }
    }
}

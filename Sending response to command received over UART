#include <stdio.h>
#include <string.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/uart.h"

#define UART_PORT UART_NUM_0
#define BUF_SIZE 128

void app_main(void)
{
    uint8_t rx_byte;
    char command[BUF_SIZE];
    int index = 0;

    // UART configuration
    uart_config_t uart_config = {
        .baud_rate = 115200,
        .data_bits = UART_DATA_8_BITS,
        .parity = UART_PARITY_DISABLE,
        .stop_bits = UART_STOP_BITS_1,
        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE
    };

    // Configure UART
    uart_param_config(UART_PORT, &uart_config);

    // Install UART driver
    uart_driver_install(UART_PORT,BUF_SIZE * 2,0,0,NULL,0);

    printf("UART command receiver started\r\n");

    while (1)
    {
        // Receive ONE character
        int len = uart_read_bytes(UART_PORT,&rx_byte,1,pdMS_TO_TICKS(100));
        
        //printf("Length: %d\r\n", len);

        if (len > 0)
        {
            // Check for Enter key
            if (rx_byte == '\r' || rx_byte == '\n')
            {
                // Only process if we actually received something
                if (index > 0)
                {
                    command[index] = '\0';

                    printf("Received: %s\r\n", command);

                    // Check command
                    if (strcmp(command, "Hi Abhishek") == 0)
                    {
                        uart_write_bytes(UART_PORT,"Good Morning Abhishek\r\n",22);
                    }
                    else
                    {
                        uart_write_bytes(UART_PORT,"UNKNOWN COMMAND\r\n",strlen("UNKNOWN COMMAND\r\n"));
                    }

                    // Clear command buffer
                    index = 0;
                }
            }
            else
            {
                // Store received character
                if (index < BUF_SIZE - 1)
                {
                    command[index] = rx_byte;
                    index++;
                }
            }
        }
    }
}

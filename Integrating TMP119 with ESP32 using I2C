# Temprature data collection from TMP119 sensor with ESP32 with I2C protocol
#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/i2c_master.h"

#define SDA_PIN        18
#define SCL_PIN        19

#define TMP119_ADDR    0x48 // TMP119 I2C address (7-bit address)
#define TEMP_REG       0x00 // TMP119 temperature register address

void app_main(void)
{
    // -------------------------
    // 1. Configure I2C
    // -------------------------

    i2c_master_bus_config_t bus_config = {
        .i2c_port = I2C_NUM_0,
        .sda_io_num = SDA_PIN,
        .scl_io_num = SCL_PIN,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .flags.enable_internal_pullup = true,
    };

    i2c_master_bus_handle_t bus;

    i2c_new_master_bus(&bus_config, &bus); // Create a new I2C master bus with the specified configuration


    // -------------------------
    // 2. Configure TMP119
    // -------------------------

    i2c_device_config_t tmp119_config = {
        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
        .device_address = TMP119_ADDR,
        .scl_speed_hz = 100000,
    };

    i2c_master_dev_handle_t tmp119;

    i2c_master_bus_add_device( bus, &tmp119_config, &tmp119); // Add TMP119 device to the I2C bus


    // -------------------------
    // 3. Read temperature
    // -------------------------

    while (1)
    {
        uint8_t reg = 0x00;
        uint8_t data[2];

        esp_err_t result = i2c_master_transmit_receive(tmp119, &reg, 1, data, 2, -1); // -1 means wait forever

if (result == ESP_OK)
{
    int16_t raw_temp = (data[0] << 8) | data[1]; // Combine the two bytes into a 16-bit integer

    float temperature = raw_temp * 0.0078125f; // Convert raw temperature to Celsius (TMP119 resolution is 0.0078125°C per LSB)

    printf("Temperature = %.2f C\n", temperature);
}
else
{
    printf("Failed to read TMP119\n");
}

        vTaskDelay(pdMS_TO_TICKS(1000));
    
}
}
